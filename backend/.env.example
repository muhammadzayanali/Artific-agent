DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1
# Comma-separated Netlify / local origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001
# Railway Postgres (auto-set when you add a Postgres plugin):
# DATABASE_URL=postgresql://...
# DATABASE_SSL=1
